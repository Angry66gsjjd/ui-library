-- ============================================
-- ПРОСТАЯ GUI БИБЛИОТЕКА (РАБОЧАЯ)
-- ============================================

local Library = {}

-- НАСТРОЙКИ
Library.Settings = {
    Theme = {
        Background = Color3.fromRGB(25, 25, 35),
        Header = Color3.fromRGB(40, 40, 55),
        Button = Color3.fromRGB(60, 60, 85),
        ButtonHover = Color3.fromRGB(80, 80, 110),
        Text = Color3.fromRGB(255, 255, 255),
        Accent = Color3.fromRGB(100, 150, 255),
        Section = Color3.fromRGB(35, 35, 50)
    },
    Width = 340,
    Height = 480
}

-- ОСНОВНОЕ ОКНО
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "CustomGUI"
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false
ScreenGui.Enabled = false  -- Скрыто по умолчанию

local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.Size = UDim2.new(0, Library.Settings.Width, 0, Library.Settings.Height)
MainFrame.Position = UDim2.new(0.5, -Library.Settings.Width/2, 0.5, -Library.Settings.Height/2)
MainFrame.BackgroundColor3 = Library.Settings.Theme.Background
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Library.Settings.Theme.Accent
MainFrame.Active = true
MainFrame.Draggable = true

-- ЗАГОЛОВОК
local Header = Instance.new("TextLabel")
Header.Parent = MainFrame
Header.Size = UDim2.new(1, 0, 0, 35)
Header.Position = UDim2.new(0, 0, 0, 0)
Header.BackgroundColor3 = Library.Settings.Theme.Header
Header.Text = "AUTO ASC1 + WEIGHT"
Header.TextColor3 = Library.Settings.Theme.Text
Header.Font = Enum.Font.GothamBold
Header.TextSize = 14

-- КНОПКА ЗАКРЫТИЯ
local CloseBtn = Instance.new("TextButton")
CloseBtn.Parent = Header
CloseBtn.Size = UDim2.new(0, 35, 1, 0)
CloseBtn.Position = UDim2.new(1, -35, 0, 0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.Text = "✕"
CloseBtn.TextColor3 = Library.Settings.Theme.Text
CloseBtn.TextSize = 16
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui.Enabled = false
end)

-- СКРОЛЛИНГ ФРЕЙМ
local ScrollFrame = Instance.new("ScrollingFrame")
ScrollFrame.Parent = MainFrame
ScrollFrame.Size = UDim2.new(1, 0, 1, -35)
ScrollFrame.Position = UDim2.new(0, 0, 0, 35)
ScrollFrame.BackgroundTransparency = 1
ScrollFrame.ScrollBarThickness = 4
ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)

local ScrollList = Instance.new("UIListLayout")
ScrollList.Parent = ScrollFrame
ScrollList.SortOrder = Enum.SortOrder.LayoutOrder
ScrollList.Padding = UDim.new(0, 5)

local ScrollPadding = Instance.new("UIPadding")
ScrollPadding.Parent = ScrollFrame
ScrollPadding.PaddingTop = UDim.new(0, 10)
ScrollPadding.PaddingBottom = UDim.new(0, 10)
ScrollPadding.PaddingLeft = UDim.new(0, 10)
ScrollPadding.PaddingRight = UDim.new(0, 10)

-- ПЕРЕТАСКИВАНИЕ
local dragStart, dragPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = input.Position
        dragPos = MainFrame.Position
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = nil
    end
end)

-- ============= МЕТОДЫ БИБЛИОТЕКИ =============

-- СОЗДАНИЕ СЕКЦИИ
function Library:Section(title)
    local section = Instance.new("Frame")
    section.Parent = ScrollFrame
    section.Size = UDim2.new(1, 0, 0, 35)
    section.BackgroundColor3 = Library.Settings.Theme.Section
    section.BorderSizePixel = 1
    section.BorderColor3 = Library.Settings.Theme.Accent
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = section
    titleLabel.Size = UDim2.new(1, -20, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Library.Settings.Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    
    -- Контейнер для элементов
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.LayoutOrder = section.LayoutOrder + 1
    
    local containerList = Instance.new("UIListLayout")
    containerList.Parent = container
    containerList.Padding = UDim.new(0, 5)
    
    local function updateSize()
        local totalHeight = containerList.AbsoluteContentSize.Y
        container.Size = UDim2.new(1, 0, 0, totalHeight + 5)
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ScrollList.AbsoluteContentSize.Y + 20)
    end
    
    containerList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSize)
    updateSize()
    
    return container
end

-- СОЗДАНИЕ КНОПКИ
function Library:Button(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Library.Settings.Theme.Button
    btn.Text = text
    btn.TextColor3 = Library.Settings.Theme.Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme.ButtonHover
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme.Button
    end)
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- СОЗДАНИЕ ТЕКСТА
function Library:Label(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.Size = UDim2.new(1, 0, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Library.Settings.Theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    return lbl
end

-- УВЕДОМЛЕНИЕ
function Library:Notify(title, message, duration)
    duration = duration or 3
    
    local notify = Instance.new("Frame")
    notify.Parent = ScreenGui
    notify.Size = UDim2.new(0, 250, 0, 60)
    notify.Position = UDim2.new(1, -260, 0, 10)
    notify.BackgroundColor3 = Library.Settings.Theme.Background
    notify.BorderSizePixel = 1
    notify.BorderColor3 = Library.Settings.Theme.Accent
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Parent = notify
    titleLbl.Size = UDim2.new(1, -10, 0, 20)
    titleLbl.Position = UDim2.new(0, 5, 0, 2)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Library.Settings.Theme.Accent
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 12
    
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Parent = notify
    msgLbl.Size = UDim2.new(1, -10, 0, 25)
    msgLbl.Position = UDim2.new(0, 5, 0, 22)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = Library.Settings.Theme.Text
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextWrapped = true
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    
    task.spawn(function()
        task.wait(duration)
        notify:Destroy()
    end)
end

-- ОТКРЫТЬ/ЗАКРЫТЬ
function Library:Toggle()
    ScreenGui.Enabled = not ScreenGui.Enabled
end

function Library:Open()
    ScreenGui.Enabled = true
end

function Library:Close()
    ScreenGui.Enabled = false
end

print("✅ Library loaded! Press P or Insert to open GUI")

return Library