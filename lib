-- ПЕРЕКЛЮЧЕНИЕ ТЕМЫ
function Library:SetTheme(theme)
    if theme == "Dark" or theme == "Light" then
        Library.Settings.CurrentTheme = theme
        local t = Library.Settings.Theme[theme]
        
        -- Обновляем главное окно
        if Library.MainFrame then
            Library.MainFrame.BackgroundColor3 = t.Background
            Library.MainFrame.BorderColor3 = t.Accent
        end
        
        -- Обновляем заголовок
        if Library.Header then
            Library.Header.BackgroundColor3 = t.Header
            Library.Header.TextColor3 = t.Text
        end
        
        -- Обновляем все секции
        for _, section in pairs(Library.SectionsList) do
            if section.Frame then
                section.Frame.BackgroundColor3 = t.Section
                section.Frame.BorderColor3 = t.Accent
                if section.Title then
                    section.Title.TextColor3 = t.Text
                end
            end
        end
        
        -- Обновляем все кнопки
        for _, btn in pairs(Library.ButtonsList) do
            if btn and btn.Parent then
                btn.BackgroundColor3 = t.Button
                btn.TextColor3 = t.Text
            end
        end
        
        -- Обновляем все метки
        for _, lbl in pairs(Library.LabelsList) do
            if lbl and lbl.Parent then
                lbl.TextColor3 = t.Text
            end
        end
    end
end

