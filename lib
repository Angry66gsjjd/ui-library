ScrollPadding.PaddingRight = UDim.new(0, 10)

-- ПЕРЕТАСКИВАНИЕ
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        MainFrame.Active = true
    end
end)

-- ============= МЕТОДЫ БИБЛИОТЕКИ =============

-- СОЗДАНИЕ СЕКЦИИ
function Library:Section(title)
    local section = Instance.new("Frame")
    section.Parent = ScrollFrame
    section.Size = UDim2.new(1, 0, 0, 40)
    section.BackgroundColor3 = Library.Settings.Theme.Section
    section.BorderSizePixel = 1
    section.BorderColor3 = Library.Settings.Theme.Accent
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = section
    titleLabel.Size = UDim2.new(1, -20, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Library.Settings.Theme.Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    
    -- Контейнер для элементов внутри секции
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.LayoutOrder = section.LayoutOrder + 1
    
    local containerList = Instance.new("UIListLayout")
    containerList.Parent = container
    containerList.Padding = UDim.new(0, 4)
    
    local function updateSize()
        local totalHeight = containerList.AbsoluteContentSize.Y
        container.Size = UDim2.new(1, 0, 0, totalHeight + 10)
        section.Size = UDim2.new(1, 0, 0, 35)
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ScrollList.AbsoluteContentSize.Y + 20)
    end
    
    containerList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSize)
    updateSize()
    
    return container
end

-- СОЗДАНИЕ КНОПКИ
function Library:Button(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Library.Settings.Theme.Button
    btn.Text = text
    btn.TextColor3 = Library.Settings.Theme.Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme.ButtonHover
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme.Button
    end)
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- СОЗДАНИЕ ТЕКСТА
function Library:Label(parent, text, color)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.Size = UDim2.new(1, 0, 0, 25)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color or Library.Settings.Theme.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    return lbl
end

-- СОЗДАНИЕ ТОГГЛА
function Library:Toggle(parent, text, callback, defaultValue)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, 0, 0, 30)
    frame.BackgroundTransparency = 1
    
    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.new(1, -50, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Library.Settings.Theme.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = frame
    toggleBtn.Size = UDim2.new(0, 40, 0, 22)
    toggleBtn.Position = UDim2.new(1, -45, 0.5, -11)
    toggleBtn.BackgroundColor3 = Library.Settings.Theme.Button
    toggleBtn.Text = ""
    
    local toggleIndicator = Instance.new("Frame")
    toggleIndicator.Parent = toggleBtn
    toggleIndicator.Size = UDim2.new(0, 18, 0, 18)
    toggleIndicator.Position = UDim2.new(0, 2, 0.5, -9)
    toggleIndicator.BackgroundColor3 = Library.Settings.Theme.Text
    
    local state = defaultValue or false
    
    local function updateToggle()
        if state then
            toggleBtn.BackgroundColor3 = Library.Settings.Theme.Accent
            toggleIndicator.Position = UDim2.new(1, -20, 0.5, -9)
        else
            toggleBtn.BackgroundColor3 = Library.Settings.Theme.Button
            toggleIndicator.Position = UDim2.new(0, 2, 0.5, -9)
        end
    end
    
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        updateToggle()
        if callback then callback(state) end
    end)
    
    updateToggle()
    return {Set = function(_, val) state = val; updateToggle() end}
end

-- СОЗДАНИЕ УВЕДОМЛЕНИЯ
function Library:Notify(title, message, duration)
    duration = duration or 3
    
    local notify = Instance.new("Frame")
    notify.Parent = ScreenGui
    notify.Size = UDim2.new(0, 250, 0, 60)
    notify.Position = UDim2.new(1, -270, 0, 10)
    notify.BackgroundColor3 = Library.Settings.Theme.Background
    notify.BorderSizePixel = 1
    notify.BorderColor3 = Library.Settings.Theme.Accent
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Parent = notify
    titleLbl.Size = UDim2.new(1, -10, 0, 20)
    titleLbl.Position = UDim2.new(0, 5, 0, 2)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Library.Settings.Theme.Accent
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 12
    
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Parent = notify
    msgLbl.Size = UDim2.new(1, -10, 0, 25)
    msgLbl.Position = UDim2.new(0, 5, 0, 22)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = Library.Settings.Theme.Text
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextWrapped = true
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    
    task.spawn(function()
        task.wait(duration)
        notify:Destroy()
    end)
end

-- ПОКАЗАТЬ/СКРЫТЬ GUI
function Library:Toggle()
    ScreenGui.Enabled = not ScreenGui.Enabled
end

-- ============= ВОЗВРАЩАЕМ БИБЛИОТЕКУ =============
return Library