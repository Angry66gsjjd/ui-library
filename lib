-- ============================================
-- ПРОСТАЯ GUI БИБЛИОТЕКА
-- ============================================

local Library = {}

-- НАСТРОЙКИ
Library.Color = {
    BG = Color3.fromRGB(25, 25, 35),
    Header = Color3.fromRGB(40, 40, 55),
    Button = Color3.fromRGB(60, 60, 85),
    ButtonHover = Color3.fromRGB(80, 80, 110),
    Text = Color3.fromRGB(255, 255, 255),
    Accent = Color3.fromRGB(100, 150, 255),
    Section = Color3.fromRGB(35, 35, 50)
}

-- ОКНО
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SimpleGUI"
ScreenGui.Parent = game:GetService("CoreGui")
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.Size = UDim2.new(0, 320, 0, 450)
MainFrame.Position = UDim2.new(0.5, -160, 0.5, -225)
MainFrame.BackgroundColor3 = Library.Color.BG
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Library.Color.Accent
MainFrame.Active = true
MainFrame.Draggable = true

local Corner = Instance.new("UICorner")
Corner.Parent = MainFrame
Corner.CornerRadius = UDim.new(0, 8)

-- ЗАГОЛОВОК
local Header = Instance.new("TextLabel")
Header.Parent = MainFrame
Header.Size = UDim2.new(1, 0, 0, 35)
Header.BackgroundColor3 = Library.Color.Header
Header.Text = "AUTO ASC1 + WEIGHT"
Header.TextColor3 = Library.Color.Text
Header.Font = Enum.Font.GothamBold
Header.TextSize = 14

local HeaderCorner = Instance.new("UICorner")
HeaderCorner.Parent = Header
HeaderCorner.CornerRadius = UDim.new(0, 8)

-- КНОПКА ЗАКРЫТИЯ
local CloseBtn = Instance.new("TextButton")
CloseBtn.Parent = Header
CloseBtn.Size = UDim2.new(0, 35, 1, 0)
CloseBtn.Position = UDim2.new(1, -35, 0, 0)
CloseBtn.BackgroundTransparency = 1
CloseBtn.Text = "✕"
CloseBtn.TextColor3 = Library.Color.Text
CloseBtn.TextSize = 16
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui.Enabled = false
end)

-- СКРОЛЛ
local Scroll = Instance.new("ScrollingFrame")
Scroll.Parent = MainFrame
Scroll.Size = UDim2.new(1, 0, 1, -35)
Scroll.Position = UDim2.new(0, 0, 0, 35)
Scroll.BackgroundTransparency = 1
Scroll.ScrollBarThickness = 4
Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)

local ScrollList = Instance.new("UIListLayout")
ScrollList.Parent = Scroll
ScrollList.Padding = UDim.new(0, 5)

local ScrollPad = Instance.new("UIPadding")
ScrollPad.Parent = Scroll
ScrollPad.PaddingTop = UDim.new(0, 10)
ScrollPad.PaddingBottom = UDim.new(0, 10)
ScrollPad.PaddingLeft = UDim.new(0, 10)
ScrollPad.PaddingRight = UDim.new(0, 10)

-- ПЕРЕТАСКИВАНИЕ
local dragStart, dragPos
MainFrame.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = inp.Position
        dragPos = MainFrame.Position
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
        local delta = inp.Position - dragStart
        MainFrame.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
    end
end)

game:GetService("UserInputService").InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = nil
    end
end)

-- ============= МЕТОДЫ =============

function Library:Section(title)
    local section = Instance.new("Frame")
    section.Parent = Scroll
    section.Size = UDim2.new(1, 0, 0, 35)
    section.BackgroundColor3 = Library.Color.Section
    section.BorderSizePixel = 1
    section.BorderColor3 = Library.Color.Accent
    
    local sectionCorner = Instance.new("UICorner")
    sectionCorner.Parent = section
    sectionCorner.CornerRadius = UDim.new(0, 5)
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Parent = section
    titleLbl.Size = UDim2.new(1, -15, 1, 0)
    titleLbl.Position = UDim2.new(0, 10, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Library.Color.Text
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 13
    
    local container = Instance.new("Frame")
    container.Parent = Scroll
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.LayoutOrder = section.LayoutOrder + 1
    
    local containerList = Instance.new("UIListLayout")
    containerList.Parent = container
    containerList.Padding = UDim.new(0, 5)
    
    local function update()
        container.Size = UDim2.new(1, 0, 0, containerList.AbsoluteContentSize.Y + 5)
        Scroll.CanvasSize = UDim2.new(0, 0, 0, ScrollList.AbsoluteContentSize.Y + 20)
    end
    
    containerList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(update)
    update()
    
    return container
end

function Library:Button(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Library.Color.Button
    btn.Text = text
    btn.TextColor3 = Library.Color.Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.Parent = btn
    btnCorner.CornerRadius = UDim.new(0, 5)
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Library.Color.ButtonHover
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Library.Color.Button
    end)
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

function Library:Label(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.Size = UDim2.new(1, 0, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Library.Color.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    return lbl
end

function Library:Notify(msg)
    local notify = Instance.new("Frame")
    notify.Parent = ScreenGui
    notify.Size = UDim2.new(0, 250, 0, 40)
    notify.Position = UDim2.new(1, -260, 0, 10)
    notify.BackgroundColor3 = Library.Color.BG
    notify.BorderSizePixel = 1
    notify.BorderColor3 = Library.Color.Accent
    
    local notifyCorner = Instance.new("UICorner")
    notifyCorner.Parent = notify
    notifyCorner.CornerRadius = UDim.new(0, 6)
    
    local text = Instance.new("TextLabel")
    text.Parent = notify
    text.Size = UDim2.new(1, -10, 1, 0)
    text.Position = UDim2.new(0, 5, 0, 0)
    text.BackgroundTransparency = 1
    text.Text = msg
    text.TextColor3 = Library.Color.Text
    text.TextSize = 12
    
    task.spawn(function()
        task.wait(2)
        notify:Destroy()
    end)
end

function Library:Toggle()
    ScreenGui.Enabled = not ScreenGui.Enabled
end

function Library:Open()
    ScreenGui.Enabled = true
end

function Library:Close()
    ScreenGui.Enabled = false
end

print("✅ Simple GUI Library loaded! Press P or Insert to open")
return Library