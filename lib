-- СОЗДАНИЕ СЕКЦИИ
function Library:Section(title)
    local section = Instance.new("Frame")
    section.Parent = ScrollFrame
    section.Size = UDim2.new(1, 0, 0, 36)
    section.BackgroundColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Section
    section.BorderSizePixel = 1
    section.BorderColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Accent
    
    local sectionCorner = Instance.new("UICorner")
    sectionCorner.Parent = section
    sectionCorner.CornerRadius = UDim.new(0, 5)
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = section
    titleLabel.Size = UDim2.new(1, -20, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Text
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 13
    
    local container = Instance.new("Frame")
    container.Parent = ScrollFrame
    container.Size = UDim2.new(1, 0, 0, 0)
    container.BackgroundTransparency = 1
    container.LayoutOrder = section.LayoutOrder + 1
    
    local containerList = Instance.new("UIListLayout")
    containerList.Parent = container
    containerList.Padding = UDim.new(0, 5)
    
    local function updateSize()
        local totalHeight = containerList.AbsoluteContentSize.Y
        container.Size = UDim2.new(1, 0, 0, totalHeight + 8)
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ScrollList.AbsoluteContentSize.Y + 20)
    end
    
    containerList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSize)
    updateSize()
    
    table.insert(Library.SectionsList, {Frame = section, Title = titleLabel, Container = container})
    
    return container
end

-- СОЗДАНИЕ КНОПКИ
function Library:Button(parent, text, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Button
    btn.Text = text
    btn.TextColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.Parent = btn
    btnCorner.CornerRadius = UDim.new(0, 5)
    
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].ButtonHover
    end)
    
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Button
    end)
    
    btn.MouseButton1Click:Connect(callback)
    table.insert(Library.ButtonsList, btn)
    return btn
end

-- СОЗДАНИЕ ТЕКСТА
function Library:Label(parent, text, color)
    local lbl = Instance.new("TextLabel")
    lbl.Parent = parent
    lbl.Size = UDim2.new(1, 0, 0, 24)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = color or Library.Settings.Theme[Library.Settings.CurrentTheme].Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    table.insert(Library.LabelsList, lbl)
    return lbl
end

-- УВЕДОМЛЕНИЕ
function Library:Notify(title, message, duration)
    duration = duration or 3
    
    local notify = Instance.new("Frame")
    notify.Parent = ScreenGui
    notify.Size = UDim2.new(0, 260, 0, 65)
    notify.Position = UDim2.new(1, -280, 0, 15)
    notify.BackgroundColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Background
    notify.BorderSizePixel = 1
    notify.BorderColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Accent
    
    local notifyCorner = Instance.new("UICorner")
    notifyCorner.Parent = notify
    notifyCorner.CornerRadius = UDim.new(0, 6)
    
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Parent = notify
    titleLbl.Size = UDim2.new(1, -10, 0, 22)
    titleLbl.Position = UDim2.new(0, 5, 0, 2)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Accent
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 12
    
    local msgLbl = Instance.new("TextLabel")
    msgLbl.Parent = notify
    msgLbl.Size = UDim2.new(1, -10, 0, 28)
    msgLbl.Position = UDim2.new(0, 5, 0, 24)
    msgLbl.BackgroundTransparency = 1
    msgLbl.Text = message
    msgLbl.TextColor3 = Library.Settings.Theme[Library.Settings.CurrentTheme].Text
    msgLbl.TextXAlignment = Enum.TextXAlignment.Left
    msgLbl.TextWrapped = true
    msgLbl.Font = Enum.Font.Gotham
    msgLbl.TextSize = 11
    
    task.spawn(function()
        task.wait(duration)
        notify:Destroy()
    end)
end

